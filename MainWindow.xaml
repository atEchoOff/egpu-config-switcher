<Window x:Class="eGPUConfigSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eGPUConfigSwitcher"
        Title="eGPU Config Switcher" Height="480" Width="385" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" ResizeMode="NoResize">
    <Window.Resources>
        <!-- Custom Scrollbar Thumb Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#334155" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <ScrollBar Name="PART_VerticalScrollBar" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" HorizontalAlignment="Right"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main Window Header Button Style -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e293b"/>
                                <Setter Property="Foreground" Value="#f8fafc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Config Card Style -->
        <Style x:Key="ConfigCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#131b2e"/>
            <Setter Property="BorderBrush" Value="#232f4a"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                    <Setter Property="BorderBrush" Value="#0f766e"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.6" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/> <!-- Title bar -->
                <RowDefinition Height="Auto"/> <!-- Action Area (Add Button) -->
                <RowDefinition Height="*"/> <!-- Scroll View of Configs -->
                <RowDefinition Height="15"/> <!-- Bottom Margin Spacer -->
            </Grid.RowDefinitions>

            <!-- Custom Header / Titlebar -->
            <Grid Grid.Row="0" Name="TitleBar" Background="#0f172a" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,383,55" RadiusX="16" RadiusY="16"/>
                </Grid.Clip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
                    <!-- Custom vector GPU icon in header -->
                    <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <!-- Bracket (Silver/Grey) -->
                            <Path Data="M 1.5,5 H 3 V 19 H 1.5 Z" Fill="#94a3b8"/>
                            <!-- PCIe Connector (Gold/Yellow) -->
                            <Path Data="M 7,16 H 18 V 17 H 7 Z" Fill="#fbbf24"/>
                            <!-- Shroud (Dark Slate) -->
                            <Path Data="M 3.5,7 H 21.5 V 15.5 H 3.5 Z" Fill="#1e293b"/>
                            <!-- Fan 1: Center (9.0, 11.25), Radius 2.5 -->
                            <Path Data="M 9,8.75 A 2.5,2.5 0 1,1 8.99,8.75 Z" Fill="#06b6d4"/>
                            <!-- Fan 2: Center (16.0, 11.25), Radius 2.5 -->
                            <Path Data="M 16,8.75 A 2.5,2.5 0 1,1 15.99,8.75 Z" Fill="#06b6d4"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="eGPU Config Switcher" Foreground="#f8fafc" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Name="GpuBadge" CornerRadius="6" Padding="6,3" Margin="10,0,0,0" VerticalAlignment="Center" Background="#1e293b">
                        <TextBlock Name="TxtGpuBadge" Text="DETECTING..." FontSize="9.5" FontWeight="Bold" Foreground="#94a3b8"/>
                    </Border>
                </StackPanel>

                <!-- Window actions (Close only, vector icon) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Arrow">
                    <Button Name="BtnClose" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="Bdr" Background="Transparent" CornerRadius="6">
                                    <Path Name="Cross" Data="M 3,3 L 9,9 M 9,3 L 3,9" Stroke="#64748b" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bdr" Property="Background" Value="#ef4444"/>
                                        <Setter TargetName="Cross" Property="Stroke" Value="#ffffff"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Action Area -->
            <StackPanel Grid.Row="1" Margin="20,20,20,10">
                <Button Name="BtnAddConfig" Height="42" Cursor="Hand" BorderThickness="0" Click="BtnAddConfig_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0284c7" Offset="0.0"/>
                            <GradientStop Color="#4f46e5" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Name="Bdr" Background="{TemplateBinding Background}" CornerRadius="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 0,5 L 10,5 M 5,0 L 5,10" Stroke="#ffffff" StrokeThickness="2" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Config File" Foreground="#ffffff" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bdr" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0ea5e9" Offset="0.0"/>
                                                <GradientStop Color="#6366f1" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Config List Area -->
            <Grid Grid.Row="2" Margin="20,10,20,0">
                <!-- ScrollViewer wrapping a styled ListBox -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox Name="LstConfigs" Background="Transparent" BorderThickness="0" 
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ConfigFile}">
                                <Border Style="{StaticResource ConfigCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Filename -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" Foreground="#f8fafc" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Remove Button (Trash Icon) -->
                                        <Button Grid.Row="0" Grid.Column="1" Width="26" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4" VerticalAlignment="Center"
                                                Tag="{Binding}" Click="BtnRemove_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Name="Bdr" Background="Transparent" CornerRadius="4">
                                                        <Path Name="Trash" Data="M 3,6 L 13,6 M 5,6 L 5,13 A 1,1 0 0 0 6,14 L 10,14 A 1,1 0 0 0 11,13 L 11,6 M 7,6 L 7,3 A 1,1 0 0 1 8,2 L 8,2 A 1,1 0 0 1 9,3 L 9,6" Stroke="#475569" StrokeThickness="1.3" Width="11" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bdr" Property="Background" Value="#222d42"/>
                                                            <Setter TargetName="Trash" Property="Stroke" Value="#ef4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Path -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Path}" Foreground="#475569" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,12" ToolTip="{Binding Path}"/>

                                        <!-- Controls panel (Freeze/Unfreeze) -->
                                        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" LastChildFill="False">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <!-- Freeze Button -->
                                                <Button Name="BtnCardFreeze" Content="Freeze" Width="75" Height="26" Margin="0,0,8,0" Cursor="Hand" FontSize="11" FontWeight="Medium"
                                                        Tag="{Binding}" Click="BtnCardFreeze_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#182235"/>
                                                            <Setter Property="BorderBrush" Value="#232f4a"/>
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                                    <Setter Property="Background" Value="#083344"/>
                                                                    <Setter Property="BorderBrush" Value="#06b6d4"/>
                                                                    <Setter Property="Foreground" Value="#22d3ee"/>
                                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#2d3748"/>
                                                                    <Setter Property="BorderBrush" Value="#475569"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Unfreeze Button -->
                                                <Button Name="BtnCardUnfreeze" Content="Unfreeze" Width="75" Height="26" Cursor="Hand" FontSize="11" FontWeight="Medium"
                                                        Tag="{Binding}" Click="BtnCardUnfreeze_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#182235"/>
                                                            <Setter Property="BorderBrush" Value="#232f4a"/>
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFrozen}" Value="False">
                                                                    <Setter Property="Background" Value="#022c22"/>
                                                                    <Setter Property="BorderBrush" Value="#10b981"/>
                                                                    <Setter Property="Foreground" Value="#34d399"/>
                                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#2d3748"/>
                                                                    <Setter Property="BorderBrush" Value="#475569"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>

                                            <!-- State Badge -->
                                            <Border Name="BadgeState" DockPanel.Dock="Right" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#065f46"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                                    <Setter Property="Background" Value="#083344"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Name="TxtState" FontSize="9.5" FontWeight="Bold" Foreground="#ffffff">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="UNFROZEN"/>
                                                            <Setter Property="Foreground" Value="#d1fae5"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                                    <Setter Property="Text" Value="FROZEN"/>
                                                                    <Setter Property="Foreground" Value="#22d3ee"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Empty state placeholder -->
                <TextBlock Name="TxtPlaceholder" Text="No config files added yet.&#x0a;Click 'Add Config File' above to start." 
                           Foreground="#475569" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" 
                           VerticalAlignment="Center" LineHeight="18" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
